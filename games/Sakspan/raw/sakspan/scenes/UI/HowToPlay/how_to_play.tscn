[node name="VisionSystem" type="Label" parent="MainContainer/TabContainer/Mechanics/MechanicsContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 14
text = "👁️ VISION SYSTEM
• Seekers have a cone of vision with light
• Only players within the vision cone can be spotted
• Walls and obstacles block line of sight
• Spotted players receive an alert warning
• Vision cone follows mouse movement"
autowrap_mode = 3

[node name="ShadowHiding" type="Label" parent="MainContainer/TabContainer/Mechanics/MechanicsContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 14
text = "🌑 SHADOW HIDING
• Players in dark areas are hidden from detection
• Shadows provide complete protection from spotting
• Light sources can expose hidden players
• Strategic positioning in shadows is key to survival
• Shadow indicator shows when you're hidden"
autowrap_mode = 3

[node name="CombatSystem" type="Label" parent="MainContainer/TabContainer/Mechanics/MechanicsContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 14
text = "🎯 COMBAT SYSTEM
• BANG Attacks: Seeker's ranged stone projectiles
• SAK Attacks: Hider's close-range elimination ability
• Line of sight required for all attacks
• Shadow-hidden players cannot be attacked
• Ammo and ability cooldowns add strategy"
autowrap_mode = 3

[node name="Controls" type="ScrollContainer" parent="MainContainer/TabContainer"]
