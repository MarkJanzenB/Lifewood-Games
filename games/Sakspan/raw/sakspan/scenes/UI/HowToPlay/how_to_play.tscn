[node name="Overview" type="ScrollContainer" parent="MainContainer/TabContainer"]
layout_mode = 2
metadata/_tab_name = "🎯 Overview"

[node name="OverviewContent" type="VBoxContainer" parent="MainContainer/TabContainer/Overview"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 15

[node name="GameOverview" type="Label" parent="MainContainer/TabContainer/Overview/OverviewContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "🎯 GAME OVERVIEW

Sakspan is a thrilling multiplayer hide-and-seek game where players are divided into two roles: Hiders and Seekers. The goal is simple - Hiders must survive by avoiding detection, while Seekers must eliminate all Hiders to win!

🎮 OBJECTIVE
• Hiders: Survive by staying hidden and avoiding the Seeker
• Seeker: Hunt down and eliminate all Hiders before time runs out
• Use strategy, teamwork, and the environment to achieve victory

🌟 KEY FEATURES
• Real-time multiplayer action
• Dynamic shadow hiding system
• Vision cone detection mechanics
• Strategic combat with BANG and SAK attacks
• Multiple game phases for varied gameplay"
autowrap_mode = 3

[node name="Roles" type="ScrollContainer" parent="MainContainer/TabContainer"]
layout_mode = 2
metadata/_tab_name = "👥 Roles"

[node name="RolesContent" type="VBoxContainer" parent="MainContainer/TabContainer/Roles"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 15

[node name="SeekerInfo" type="Label" parent="MainContainer/TabContainer/Roles/RolesContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.4, 0.4, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "🔍 SEEKER (1 player)
• Hunt down all Hiders to win the game
• Armed with stone projectiles (BANG attacks)
• Has a vision cone with light that reveals nearby areas
• Can spot Hiders within their vision cone
• Ammo regenerates over time (2 seconds per stone)
• Cannot see during the Hider Head Start phase
• Must manage ammo carefully and use strategy"
autowrap_mode = 3

[node name="HiderInfo" type="Label" parent="MainContainer/TabContainer/Roles/RolesContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.4, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "🫥 HIDERS (All other players)
• Survive until the end to win as a team
• Use stealth and hiding spots to avoid detection
• Can perform SAK attacks to eliminate the Seeker
• Must stay hidden and use shadows strategically
• Work together to outlast the Seeker
• Only need one Hider to survive for team victory
• Can coordinate attacks and distractions"
autowrap_mode = 3

[node name="GamePhases" type="ScrollContainer" parent="MainContainer/TabContainer"]
layout_mode = 2
metadata/_tab_name = "⏰ Phases"

[node name="PhasesContent" type="VBoxContainer" parent="MainContainer/TabContainer/GamePhases"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 15

[node name="Phase1" type="Label" parent="MainContainer/TabContainer/GamePhases/PhasesContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 0.4, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "1️⃣ HIDER HEAD START (10 seconds)
• Hiders can move freely to find hiding spots
• Seeker is BLINDED and cannot see or spot anyone
• Use this time wisely to find strategic positions
• Look for shadow areas and good cover
• Plan escape routes and hiding strategies"
autowrap_mode = 3

[node name="Phase2" type="Label" parent="MainContainer/TabContainer/GamePhases/PhasesContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.6, 0.4, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "2️⃣ SEEKER RELEASED (5 seconds)
• Seeker's vision is restored
• Countdown before full gameplay begins
• Final moments to get into position
• Seeker can start moving and looking around
• Hiders should finalize their hiding spots"
autowrap_mode = 3

[node name="Phase3" type="Label" parent="MainContainer/TabContainer/GamePhases/PhasesContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 1, 0.4, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "3️⃣ FULL GAMEPLAY
• All abilities are active
• Seeker can hunt and attack with BANG
• Hiders can use SAK attacks for elimination
• Game continues until win condition is met
• Strategic gameplay with all mechanics enabled"
autowrap_mode = 3

[node name="Mechanics" type="ScrollContainer" parent="MainContainer/TabContainer"]
layout_mode = 2
metadata/_tab_name = "⚙️ Mechanics"

[node name="MechanicsContent" type="VBoxContainer" parent="MainContainer/TabContainer/Mechanics"]
