[node name="HiderStrategy" type="Label" parent="MainContainer/TabContainer/Strategy/StrategyContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.4, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "🫥 FOR HIDERS:
• Use the 10-second head start to find optimal hiding spots
• Stay in shadows and dark areas to avoid detection
• Use walls and obstacles to break line of sight
• Coordinate with other Hiders for team survival
• Wait for the right moment to use SAK attacks
• Move carefully to avoid making noise or being seen
• Create distractions to help teammates escape"
autowrap_mode = 3

[node name="SeekerStrategy" type="Label" parent="MainContainer/TabContainer/Strategy/StrategyContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.4, 0.4, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "🔍 FOR SEEKERS:
• Use your vision cone strategically to sweep areas
• Learn the map layout to predict hiding spots
• Manage your ammo carefully (2 seconds per stone)
• Use light to expose players hiding in shadows
• Be patient and methodical in your search
• Remember that walls block your vision and attacks
• Listen for movement sounds and visual cues"
autowrap_mode = 3

