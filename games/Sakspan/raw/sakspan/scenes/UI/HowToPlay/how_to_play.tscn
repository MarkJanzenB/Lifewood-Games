theme_override_font_sizes/font_size = 16
text = "⌨️ MOVEMENT CONTROLS
• WASD or Arrow Keys: Move your character
• Mouse Movement: Control vision cone direction (Seeker)
• Smooth movement in all directions
• Use movement to avoid detection or hunt targets"
autowrap_mode = 3

[node name="AttackControls" type="Label" parent="MainContainer/TabContainer/Controls/ControlsContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "🎯 ATTACK CONTROLS
• Left Click or Space: Attack (BANG/SAK)
• Mouse: Aim your attacks
• Seeker: Left Click to fire stone projectiles
• Hider: Left Click for SAK attacks (close range)
• Attacks require line of sight to target
• Ammo/abilities have cooldown periods"
autowrap_mode = 3

[node name="Strategy" type="ScrollContainer" parent="MainContainer/TabContainer"]
layout_mode = 2
metadata/_tab_name = "🧠 Strategy"

[node name="StrategyContent" type="VBoxContainer" parent="MainContainer/TabContainer/Strategy"]
layout_mode = 2
